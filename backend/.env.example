# =============================================================================
# RepRoot backend environment template
# =============================================================================
# SAFE PUBLIC TEMPLATE: never place real production credentials in this file.
# Copy this file manually to backend/.env for local use, or enter the same
# variables in the production hosting provider's secret/environment dashboard.
# Restart or redeploy the Django backend after changing any value.

# -----------------------------------------------------------------------------
# Django application (required)
# -----------------------------------------------------------------------------
# SECRET: generate a long, unique production value. Never reuse the example.
DJANGO_SECRET_KEY=<generate-a-long-random-production-secret>
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.your-domain.com
# Canonical public RepRoot origin. Public lead-form links use this URL.
REPROOT_FRONTEND_URL=https://www.your-domain.com

# NON-SECRET signup email policy. Leave the allowlist empty to permit valid
# company domains. For a limited public test, use a comma-separated provider
# list such as gmail.com,outlook.com,hotmail.com,yahoo.com,icloud.com,proton.me.
REPROOT_SIGNUP_ALLOWED_EMAIL_DOMAINS=
REPROOT_SIGNUP_BLOCKED_EMAIL_DOMAINS=example.com,example.org,example.net,example.test,localhost,mailinator.com,guerrillamail.com,10minutemail.com

# Browser origins only; comma-separated and without trailing slashes.
CORS_ALLOWED_ORIGINS=https://app.your-domain.com
CSRF_TRUSTED_ORIGINS=https://app.your-domain.com

# Production HTTPS/cookie protection.
# Use HTTP_CLOUDFRONT_FORWARDED_PROTO when CloudFront terminates HTTPS and the
# origin itself receives HTTP. Other trusted reverse proxies normally use
# HTTP_X_FORWARDED_PROTO.
DJANGO_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True
REPROOT_AUTH_TOKEN_TTL_HOURS=12
# NON-SECRET. Change only when the published Terms or Privacy Notice changes.
# ISO date format is required. Both professional and client consent use it.
REPROOT_LEGAL_LAST_UPDATED_DATE=2026-08-16
# Public region codes/names, comma-separated. Default launch scope: India and USA.
REPROOT_SUPPORTED_COUNTRIES=IN,INDIA,US,USA,UNITED STATES,UNITED STATES OF AMERICA

# -----------------------------------------------------------------------------
# PostgreSQL database (use DATABASE_URL in hosted production)
# -----------------------------------------------------------------------------
# SECRET: preferred single connection string supplied by the database provider.
DATABASE_URL=<postgresql-connection-url-from-provider>

# Individual PostgreSQL fields are useful for local/self-hosted operation.
# Leave DATABASE_URL blank when using these fields.
POSTGRES_DB=professional_platform
POSTGRES_USER=<database-username>
POSTGRES_PASSWORD=<database-password>
POSTGRES_HOST=<database-hostname>
POSTGRES_PORT=5432
POSTGRES_CONNECT_TIMEOUT=5
POSTGRES_CONN_MAX_AGE=60

# -----------------------------------------------------------------------------
# SMTP and application email
# -----------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=<smtp-hostname-from-email-provider>
EMAIL_PORT=587
EMAIL_HOST_USER=<smtp-username-or-sending-mailbox>
EMAIL_HOST_PASSWORD=<smtp-password-or-app-password>
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=15

# These addresses must be verified/authorized by the SMTP provider.
# Use the verified no-reply sender for account and support notifications.
DEFAULT_FROM_EMAIL=RepRoot <no-reply@your-domain.com>
SUPPORT_EMAIL=support@your-domain.com
STUDIO_SUPPORT_EMAIL=support@your-domain.com
MEETING_FROM_EMAIL=RepRoot Meetings <meetings@your-domain.com>
ERROR_ALERT_EMAIL=<private-operations-alert-mailbox>

# Public Google OAuth Web Client ID used for professional Google login.
# This is intentionally public, but it must be the same Web Client ID supplied
# to the Angular and Flutter builds. Never place the OAuth client secret in
# frontend or mobile configuration.
GOOGLE_OAUTH_CLIENT_ID=<google-oauth-web-client-id>.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# Google Calendar and Google Meet (optional until OAuth is ready)
# -----------------------------------------------------------------------------
# Keep False until every Google field below has been filled.
GOOGLE_CALENDAR_ENABLED=False
GOOGLE_CALENDAR_CLIENT_ID=<google-oauth-web-client-id>
GOOGLE_CALENDAR_CLIENT_SECRET=<google-oauth-web-client-secret>
GOOGLE_CALENDAR_REFRESH_TOKEN=<authorized-calendar-refresh-token>
GOOGLE_CALENDAR_ID=<calendar-email-or-calendar-id>
GOOGLE_CALENDAR_TIMEOUT_SECONDS=15

# -----------------------------------------------------------------------------
# Stripe subscriptions and billing (optional until Stripe is ready)
# -----------------------------------------------------------------------------
# Keep all payment mutations disabled until the selected gateway, webhooks,
# production URLs, and live credentials have been validated end to end.
REPROOT_PAYMENTS_ENABLED=False
REPROOT_BILLING_SUCCESS_URL=https://your-domain.com/professional/account-settings?billing=success
REPROOT_BILLING_CANCEL_URL=https://your-domain.com/professional/account-settings?billing=cancelled

# Publishable key is intentionally public, but it is kept here so the backend
# can return it through a controlled public-configuration endpoint if needed.
STRIPE_PUBLISHABLE_KEY=<stripe-publishable-key>
STRIPE_SECRET_KEY=<stripe-secret-key>
STRIPE_WEBHOOK_SECRET=<stripe-webhook-signing-secret>
STRIPE_PRO_PRICE_ID=<stripe-pro-recurring-price-id>
STRIPE_PREMIUM_PRICE_ID=<stripe-premium-recurring-price-id>
STRIPE_PREMIUM_UNLIMITED_PRICE_ID=<stripe-premium-unlimited-recurring-price-id>
REPROOT_BILLING_TEST_MODE=False
REPROOT_BILLING_PROVIDER=razorpay
RAZORPAY_KEY_ID=<razorpay-test-key-id>
RAZORPAY_KEY_SECRET=<razorpay-test-key-secret>
RAZORPAY_WEBHOOK_SECRET=<razorpay-test-webhook-signing-secret>
RAZORPAY_BASE_URL=https://api.razorpay.com
RAZORPAY_PERSONAL_LINK=<razorpay-dashboard-or-support-link>
REPROOT_DEMO_TRAINER_PASSWORD=<development-only-trainer-password>
REPROOT_DEMO_CLIENT_PASSWORD=<development-only-shared-client-password>

# -----------------------------------------------------------------------------
# Redis cache / queue coordination (recommended in production)
# -----------------------------------------------------------------------------
CACHE_URL=<redis-connection-url-from-provider>

# -----------------------------------------------------------------------------
# Private upload storage (required in production)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=<s3-provider-access-key-id>
AWS_SECRET_ACCESS_KEY=<s3-provider-secret-access-key>
AWS_STORAGE_BUCKET_NAME=<private-upload-bucket-name>
AWS_S3_REGION_NAME=<bucket-region>
AWS_S3_ENDPOINT_URL=<s3-compatible-endpoint-or-blank-for-aws>
AWS_S3_CUSTOM_DOMAIN=
AWS_QUERYSTRING_AUTH=True

# -----------------------------------------------------------------------------
# API throttling
# -----------------------------------------------------------------------------
THROTTLE_AUTH_RATE=20/min
THROTTLE_OTP_RATE=5/min
THROTTLE_DIRECTORY_RATE=60/min
THROTTLE_PUBLIC_REGISTRATION_RATE=30/hour
THROTTLE_ERRORS_RATE=60/min
THROTTLE_PAYMENTS_RATE=30/hour
THROTTLE_SUPPORT_RATE=30/hour

# -----------------------------------------------------------------------------
# Account lifecycle and retention
# -----------------------------------------------------------------------------
REPROOT_DEFAULT_PLAN=starter_free
REPROOT_DOWNGRADE_GRACE_PERIOD_DAYS=14
REPROOT_DATA_DELETION_DAYS=30
REPROOT_RECYCLE_BIN_DAYS=14
REPROOT_OPERATIONAL_DATA_MAX_DAYS=180
REPROOT_DATA_USAGE_CACHE_SECONDS=120
REPROOT_DATA_USAGE_WARNING_PERCENT=75
REPROOT_DATA_USAGE_DANGER_PERCENT=90
REPROOT_STORAGE_HARD_LIMIT_PERCENT=120
REPROOT_ERROR_LOG_RETENTION_DAYS=90

# -----------------------------------------------------------------------------
# Plan limits (optional overrides; defaults are defined by the backend)
# -----------------------------------------------------------------------------
REPROOT_STARTER_FREE_STORAGE_LIMIT_BYTES=104857600
REPROOT_STARTER_FREE_DATA_RETENTION_DAYS=60
REPROOT_STARTER_FREE_TEMPLATE_LIMIT=5
REPROOT_STARTER_FREE_GROUP_LIMIT=3
REPROOT_STARTER_FREE_LEAD_FORM_LIMIT=1
REPROOT_STARTER_FREE_RESOURCE_LIMIT=30
REPROOT_STARTER_FREE_CATEGORY_LIMIT=5
REPROOT_STARTER_FREE_SUBCATEGORY_LIMIT=3

REPROOT_PRO_STORAGE_LIMIT_BYTES=1073741824
REPROOT_PRO_DATA_RETENTION_DAYS=90
REPROOT_PRO_TEMPLATE_LIMIT=15
REPROOT_PRO_GROUP_LIMIT=10
REPROOT_PRO_LEAD_FORM_LIMIT=2
REPROOT_PRO_RESOURCE_LIMIT=100
REPROOT_PRO_CATEGORY_LIMIT=20
REPROOT_PRO_SUBCATEGORY_LIMIT=10

REPROOT_PREMIUM_UNLIMITED_STORAGE_LIMIT_BYTES=10737418240
REPROOT_PREMIUM_UNLIMITED_DATA_RETENTION_DAYS=180
REPROOT_PREMIUM_UNLIMITED_TEMPLATE_LIMIT=50
REPROOT_PREMIUM_UNLIMITED_GROUP_LIMIT=25
REPROOT_PREMIUM_UNLIMITED_LEAD_FORM_LIMIT=3
REPROOT_PREMIUM_UNLIMITED_RESOURCE_LIMIT=250
REPROOT_PREMIUM_UNLIMITED_CATEGORY_LIMIT=50
REPROOT_PREMIUM_UNLIMITED_SUBCATEGORY_LIMIT=20
